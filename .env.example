# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# MySQL
CI_DB_HOST=localhost
CI_DB_PORT=3306
CI_DB_USER=your_mysql_username
CI_DB_PASSWORD=your_mysql_password
CI_DB_NAME=customer_intelligence

# Google Gemini (GenAI features)
GEMINI_API_KEY=your_gemini_api_key

# Backend CORS
ALLOWED_ORIGINS=http://localhost:3000

# Optional overrides
# ML_MODEL_DIR=
DB_QUERY_TIMEOUT_SECONDS=15